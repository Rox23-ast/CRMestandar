# ==========================================
# Mudanzas Chico - Environment Variables
# ==========================================

# Server configuration
NODE_ENV=development
PORT=3000

# Database (SQLite local file)
DATABASE_URL="file:./mudanzas.db"

# Authentication (JWT)
JWT_SECRET="YOUR_SUPER_SECRET_KEY_HERE"
CRM_BOOTSTRAP_TOKEN="CREATE_A_LONG_ONE_TIME_BOOTSTRAP_TOKEN"

# WhatsApp API (Bot)
WA_API_TOKEN="YOUR_WHATSAPP_API_TOKEN"
WA_VERIFY_TOKEN="YOUR_WHATSAPP_WEBHOOK_VERIFY_TOKEN"
WA_PHONE_NUMBER_ID="YOUR_WHATSAPP_PHONE_NUMBER_ID"
WA_APP_SECRET="YOUR_META_APP_SECRET"

# OpenAI (AI Brain)
OPENAI_API_KEY="sk-tu_clave_de_openai_aqui"
