// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// CRM Module Models
// ----------------------------------------------------------------------------

model User {
  id                     String                   @id @default(uuid())
  email                  String                   @unique
  password               String // Hashed password
  name                   String
  role                   String                   @default("AGENT") // Roles: ADMIN, MARKETING_DIRECTOR, AGENT
  availabilityStatus     String                   @default("AVAILABLE") // AVAILABLE, BUSY, AWAY, OFFLINE
  maxActiveConversations Int                      @default(20)
  lastAssignedAt         DateTime?
  isActive               Boolean                  @default(true)
  tokenVersion           Int                      @default(0)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  assignedConversations  Conversation[]           @relation("ConversationAssignee")
  assignmentTargets      ConversationAssignment[] @relation("AssignmentTarget")
  assignmentActors       ConversationAssignment[] @relation("AssignmentActor")
  auditEvents            AuditEvent[]
  notifications          Notification[]
}

model Client {
  id               String         @id @default(uuid())
  phone            String         @unique // WhatsApp Phone (unique client key)
  name             String?
  botStep          String         @default("START") // Conversation state tracker
  quoteOrigin      String?        // Partial quote capture: origin answer
  quoteDestination String?        // Partial quote capture: destination answer
  quoteVolume      Float?         // Partial quote capture: volume in m3
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  quotes           Quote[]
  conversations    Conversation[]
}

// ----------------------------------------------------------------------------
// CRM Conversation Models
// ----------------------------------------------------------------------------

model Conversation {
  id                 String                   @id @default(uuid())
  clientId           String
  client             Client                   @relation(fields: [clientId], references: [id])
  assignedUserId     String?
  assignedUser       User?                    @relation("ConversationAssignee", fields: [assignedUserId], references: [id])
  assignedRole       String?
  status             String                   @default("BOT_ACTIVE") // NEW, BOT_ACTIVE, HUMAN_ACTIVE, WAITING_CUSTOMER, RESOLVED, CLOSED
  priority           String                   @default("NORMAL") // URGENT, HIGH, NORMAL, LOW
  businessStatus     String?                  // FK a ConversationStatusConfig (code)
  lastMessageAt      DateTime                 @default(now())
  firstResponseDueAt DateTime?
  nextFollowUpAt     DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  messages           Message[]
  assignments        ConversationAssignment[]
  auditEvents        AuditEvent[]
  notifications      Notification[]
  quotes             Quote[]

  @@index([status, priority, lastMessageAt])
  @@index([assignedUserId, status])
  @@index([clientId, status])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  externalId     String?      @unique
  direction      String // INBOUND, OUTBOUND
  senderType     String // CUSTOMER, BOT, AGENT
  type           String       @default("TEXT") // TEXT, IMAGE, DOCUMENT, AUDIO, UNSUPPORTED
  body           String?
  mediaId        String?
  deliveryStatus String       @default("RECEIVED") // RECEIVED, PENDING, SENT, DELIVERED, READ, FAILED
  metadata       String       @default("{}")
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model ConversationAssignment {
  id               String       @id @default(uuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id])
  assignedUserId   String?
  assignedUser     User?        @relation("AssignmentTarget", fields: [assignedUserId], references: [id])
  assignedRole     String?
  assignedByUserId String?
  assignedByUser   User?        @relation("AssignmentActor", fields: [assignedByUserId], references: [id])
  reason           String
  assignedAt       DateTime     @default(now())
  releasedAt       DateTime?

  @@index([conversationId, assignedAt])
  @@index([assignedUserId, releasedAt])
}

model AuditEvent {
  id             String        @id @default(uuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  actorUserId    String?
  actorUser      User?         @relation(fields: [actorUserId], references: [id])
  eventType      String
  payload        String        @default("{}")
  createdAt      DateTime      @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id             String        @id @default(uuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  role           String?
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  type           String
  title          String
  body           String
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([userId, readAt, createdAt])
  @@index([role, readAt, createdAt])
}

model BusinessHoursConfig {
  id             String   @id @default("default")
  timezone       String   @default("America/Bogota")
  weeklySchedule String   @default("{\"0\":null,\"1\":{\"start\":\"08:00\",\"end\":\"18:00\"},\"2\":{\"start\":\"08:00\",\"end\":\"18:00\"},\"3\":{\"start\":\"08:00\",\"end\":\"18:00\"},\"4\":{\"start\":\"08:00\",\"end\":\"18:00\"},\"5\":{\"start\":\"08:00\",\"end\":\"18:00\"},\"6\":null}")
  updatedAt      DateTime @updatedAt
}

model BusinessHoursException {
  id        String   @id @default(uuid())
  date      String   @unique // YYYY-MM-DD in the configured timezone
  isOpen    Boolean  @default(false)
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SlaPolicy {
  id                   String   @id @default("default")
  firstResponseMinutes Int      @default(15)
  followUpMinutes     Int      @default(1440)
  updatedAt            DateTime @updatedAt
}

model BootstrapState {
  id          String   @id @default("default")
  completedAt DateTime?
}

model StoredCredential {
  id        String   @id @default("default")
  data      String
  iv        String
  tag       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConversationStatusConfig {
  id        String   @id @default(uuid())
  code      String   @unique   // slug: PENDIENTE_COTIZACION
  label     String
  color     String   @default("#64748b")
  isFinal   Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Bot Configuration Models
// ----------------------------------------------------------------------------

model BotConfig {
  id                  String   @id @default(uuid())
  greetingMessage     String   @default("¡Hola! Soy el asistente virtual de Mudanzas Chico. ¿En qué te puedo ayudar hoy?")
  awayMessage         String   @default("En este momento estamos fuera de horario de atención. Déjanos tu mensaje y te contactaremos pronto.")
  aiPersonalityPrompt String   @default("Eres un asistente formal y empático de una empresa de mudanzas llamada Mudanzas Chico.")
  limitations         String   @default("No dar precios finales sin confirmación de volumen por un agente.")
  // SQLite does not natively support JSON lists, so we use String to store serialized JSON
  customRules         String   @default("[]") // Almacenará un array de { id, title, keywords, response }
  updatedAt           DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Cotizador Module Models
// ----------------------------------------------------------------------------

model Quote {
  id             String        @id @default(uuid())
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  origin         String
  destination    String
  volume         Float? // In cubic meters
  price          Float?
  externalId     String?       @unique // Quote ID in the external cotizador system
  status         String        @default("PENDING") // Status: PENDING, ACCEPTED, REJECTED
  source         String        @default("BOT") // Origin: BOT (via WhatsApp) | WEB (cotizador web form)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([conversationId])
}

// Signed webhook traffic: outbound deliveries (with retries) and inbound
// callbacks (deduplicated by event id).
model WebhookEvent {
  id            String    @id // Event id (UUID)
  direction     String // INBOUND | OUTBOUND
  event         String // quote.requested | quote.captured | quote.status.updated
  payload       String    @default("{}")
  status        String    @default("PENDING") // PENDING | DELIVERED | PROCESSED | IGNORED | FAILED
  attempts      Int       @default(0)
  lastError     String?
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([direction, status, createdAt])
}
